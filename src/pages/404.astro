---
import BaseLayout from '@layouts/BaseLayout.astro';
import Icon from '@components/Icon.astro';
import PhoneButton from '@components/PhoneButton.astro';
import WhatsAppLink from '@components/WhatsAppLink.astro';
import { servicesSorted } from '@data/services';
---

<BaseLayout title="Sayfa Bulunamadı" description="Aradığınız sayfa bulunamadı. Demir Elektrik ana sayfasına dönebilir veya hizmetlerimizi inceleyebilirsiniz." noindex>
  <section class="section nf">
    <div class="container nf__inner">
      <span class="nf__code">404</span>
      <h1>Sayfa Bulunamadı</h1>
      <p class="lead">Aradığınız sayfa taşınmış ya da kaldırılmış olabilir. Elektrik hizmeti için bizi doğrudan arayabilirsiniz.</p>
      <div class="btn-group nf__actions">
        <a href="/" class="btn btn--dark"><Icon name="house" size={18} /> Ana Sayfa</a>
        <PhoneButton showNumber />
        <WhatsAppLink />
      </div>
      <h2 class="nf__sub">Hizmetlerimiz</h2>
      <ul class="nf__links">
        {servicesSorted.map((s) => <li><a href={`/hizmetler/${s.slug}`} class="tag"><Icon name={s.icon} size={14} /> {s.shortTitle}</a></li>)}
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .nf__inner {
    text-align: center;
    max-width: 760px;
  }
  .nf__code {
    display: inline-block;
    font-size: clamp(4rem, 12vw, 7rem);
    font-weight: 900;
    line-height: 1;
    letter-spacing: -0.05em;
    background: linear-gradient(135deg, var(--yellow), var(--orange));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .nf__inner h1 {
    margin-top: 0.5rem;
  }
  .nf__inner .lead {
    margin-top: 1rem;
  }
  .nf__actions {
    justify-content: center;
    margin-top: 1.75rem;
  }
  .nf__sub {
    margin-top: 3rem;
    font-size: var(--fs-base);
    color: var(--text-gray);
  }
  .nf__links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 1rem;
  }
  .nf__links svg {
    color: var(--orange);
  }
</style>
