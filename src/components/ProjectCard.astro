---
import type { Project } from '@data/projects';
import { getCategoryLabel } from '@data/projects';
import Icon from './Icon.astro';

interface Props {
  project: Project;
}
const { project } = Astro.props;
const isVideo = Boolean(project.video);
const large = project.video ?? project.imageLarge ?? project.image ?? '';
---

<figure class="project-card reveal" data-category={project.category}>
  <a
    href={large}
    class="project-card__link"
    data-lightbox
    data-video={project.video}
    data-title={project.title}
    data-caption={getCategoryLabel(project.category) + (project.location ? ` · ${project.location}` : '')}
    aria-label={isVideo ? `${project.title} videosunu oynat` : `${project.title} görselini büyüt`}
  >
    {
      isVideo ? (
        <video
          src={project.video}
          poster={project.image}
          muted
          playsinline
          preload="metadata"
          aria-label={project.alt}
          width="600"
          height="450"
        />
      ) : (
        <img src={project.image} alt={project.alt} loading="lazy" decoding="async" width="600" height="450" />
      )
    }
    <span class="project-card__zoom"><Icon name={isVideo ? 'play' : 'zoom-in'} size={20} /></span>
    {isVideo && <span class="project-card__play" aria-hidden="true"><Icon name="play" size={28} /></span>}
    {project.placeholder && <span class="project-card__badge">Örnek görsel</span>}
  </a>
  <figcaption class="project-card__caption">
    <span class="project-card__cat">{getCategoryLabel(project.category)}</span>
    <strong>{project.title}</strong>
    {project.location && <span class="project-card__loc"><Icon name="map-pin" size={14} /> {project.location}</span>}
  </figcaption>
</figure>

<style>
  .project-card {
    margin: 0;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--white);
    border: 1px solid var(--gray-200);
    transition: transform var(--dur) var(--ease), box-shadow var(--dur) var(--ease);
  }
  .project-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
  }
  .project-card__link {
    position: relative;
    display: block;
    aspect-ratio: 4 / 3;
    background: var(--secondary-dark);
    overflow: hidden;
  }
  .project-card__link img,
  .project-card__link video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 400ms var(--ease);
  }
  .project-card:hover img,
  .project-card:hover video {
    transform: scale(1.04);
  }
  .project-card__play {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: var(--white);
    pointer-events: none;
  }
  .project-card__play :global(svg) {
    padding: 0.85rem;
    box-sizing: content-box;
    border-radius: 50%;
    background: rgba(11, 18, 32, 0.65);
    box-shadow: var(--shadow-lg);
    transition: transform var(--dur) var(--ease), background-color var(--dur) var(--ease);
  }
  .project-card:hover .project-card__play :global(svg) {
    transform: scale(1.08);
    background: var(--orange);
  }
  .project-card__zoom {
    position: absolute;
    right: 0.75rem;
    bottom: 0.75rem;
    display: inline-flex;
    padding: 0.5rem;
    border-radius: 10px;
    background: rgba(11, 18, 32, 0.7);
    color: var(--white);
    opacity: 0;
    transition: opacity var(--dur) var(--ease);
  }
  .project-card:hover .project-card__zoom,
  .project-card__link:focus-visible .project-card__zoom {
    opacity: 1;
  }
  .project-card__badge {
    position: absolute;
    left: 0.75rem;
    top: 0.75rem;
    padding: 0.25rem 0.625rem;
    border-radius: 999px;
    background: rgba(11, 18, 32, 0.75);
    color: var(--on-dark);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .project-card__caption {
    display: grid;
    gap: 0.2rem;
    padding: 0.875rem 1rem 1rem;
  }
  .project-card__cat {
    font-size: var(--fs-xs);
    font-weight: 700;
    color: var(--orange);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .project-card__loc {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-size: var(--fs-xs);
    color: var(--text-gray);
  }
</style>
