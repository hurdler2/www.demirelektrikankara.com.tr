---
import { lightingCards } from '@data/site';
import Icon from './Icon.astro';
import SectionTitle from './SectionTitle.astro';
---

<section class="section section--gray" id="aydinlatma" aria-labelledby="lighting-title">
  <div class="container">
    <SectionTitle align="center" eyebrow="Aydınlatma hizmetleri" title="LED, Spot ve Avize Montajı" text="Ev, villa, mağaza ve ofisler için estetik ve güvenli aydınlatma uygulamaları." />
    <div class="lighting">
      {
        lightingCards.map((c, i) => (
          <a href={`/hizmetler/${c.slug}`} class="lighting__card reveal" data-delay={i}>
            <div class="lighting__media">
              <img src={c.image} alt="" width="600" height="400" loading="lazy" decoding="async" />
              <span class="icon-badge icon-badge--solid"><Icon name={c.icon} /></span>
            </div>
            <div class="lighting__body">
              <h3>{c.title}</h3>
              <p>{c.text}</p>
              <span class="lighting__more">Detaylı Bilgi <Icon name="arrow-right" size={16} /></span>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .lighting {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 768px) {
    .lighting {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .lighting__card {
    display: flex;
    flex-direction: column;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--white);
    border: 1px solid var(--gray-200);
    transition: transform var(--dur) var(--ease), box-shadow var(--dur) var(--ease);
  }
  .lighting__card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
  }
  .lighting__media {
    position: relative;
    aspect-ratio: 3 / 2;
    background: var(--secondary-dark);
  }
  .lighting__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .lighting__media .icon-badge {
    position: absolute;
    left: 1rem;
    bottom: -20px;
    box-shadow: var(--shadow);
  }
  .lighting__body {
    display: grid;
    gap: 0.5rem;
    padding: 2rem 1.25rem 1.25rem;
  }
  .lighting__body p {
    color: var(--text-gray);
    font-size: var(--fs-sm);
  }
  .lighting__more {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    margin-top: 0.5rem;
    font-weight: 700;
    font-size: var(--fs-sm);
    color: var(--orange);
  }
</style>
