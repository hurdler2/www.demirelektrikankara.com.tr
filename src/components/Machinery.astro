---
import { machineryScope } from '@data/site';
import Icon from './Icon.astro';
import SectionTitle from './SectionTitle.astro';
import PhoneButton from './PhoneButton.astro';
---

<section class="section machinery" id="is-makineleri" aria-labelledby="machinery-title">
  <div class="container machinery__inner">
    <div class="machinery__visual reveal" aria-hidden="true">
      <div class="machinery__icon"><Icon name="tractor" size={72} strokeWidth={1.5} /></div>
      <div class="machinery__chips">
        <span><Icon name="gauge" size={16} /> Sensör</span>
        <span><Icon name="circuit-board" size={16} /> Kontrol</span>
        <span><Icon name="cable" size={16} /> Tesisat</span>
        <span><Icon name="settings" size={16} /> Otomasyon</span>
      </div>
    </div>
    <div class="machinery__content">
      <SectionTitle eyebrow="Şantiye ve saha hizmeti" title="İş Makineleri Elektrik ve Otomasyon Hizmetleri" text="İş makinelerinin elektrik tesisatı, elektrik arızaları ve kontrol sistemleri konusunda teknik hizmet sunuyoruz." />
      <ul class="check-list machinery__scope">
        {machineryScope.map((s) => <li>{s}</li>)}
      </ul>
      <div class="btn-group machinery__actions">
        <a href="/hizmetler/is-makinesi-elektrik-otomasyonu" class="btn btn--dark">Detaylı Bilgi <Icon name="arrow-right" size={18} /></a>
        <PhoneButton />
      </div>
    </div>
  </div>
</section>

<style>
  .machinery {
    background: var(--white);
  }
  .machinery__inner {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }
  @media (min-width: 960px) {
    .machinery__inner {
      grid-template-columns: 0.9fr 1.1fr;
      gap: 4rem;
    }
  }
  .machinery__visual {
    position: relative;
    display: grid;
    place-items: center;
    gap: 1.5rem;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-lg);
    background:
      radial-gradient(60% 60% at 50% 40%, rgba(255, 193, 7, 0.22), transparent 70%),
      linear-gradient(160deg, var(--secondary-dark), var(--primary-dark));
    color: var(--yellow);
    overflow: hidden;
  }
  .machinery__visual::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgba(255, 255, 255, 0.12) 1px, transparent 1px);
    background-size: 22px 22px;
  }
  .machinery__icon {
    position: relative;
    display: grid;
    place-items: center;
    width: 140px;
    height: 140px;
    border-radius: 36px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid var(--border-dark);
  }
  .machinery__chips {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    padding-inline: 1rem;
  }
  .machinery__chips span {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.375rem 0.75rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.08);
    color: var(--white);
    font-size: var(--fs-xs);
    font-weight: 600;
  }
  .machinery__scope {
    grid-template-columns: 1fr;
  }
  @media (min-width: 480px) {
    .machinery__scope {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  .machinery__actions {
    margin-top: 1.75rem;
  }
</style>
