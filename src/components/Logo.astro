---
interface Props {
  /** Koyu zemin üzerinde mi (varsayılan) */
  onDark?: boolean;
  size?: 'sm' | 'md' | 'lg';
}
const { onDark = true, size = 'md' } = Astro.props;
---

<span class:list={['logo', `logo--${size}`, { 'logo--light': !onDark }]}>
  <span class="logo__mark" aria-hidden="true">
    <svg viewBox="0 0 40 40" width="40" height="40" xmlns="http://www.w3.org/2000/svg" focusable="false">
      <rect width="40" height="40" rx="10" fill="var(--yellow)"></rect>
      <path d="M22.5 6 11 22.5h8l-1.5 11.5L28.5 17h-8z" fill="#0b1220"></path>
    </svg>
  </span>
  <span class="logo__text">
    <span class="logo__name">DEMİR ELEKTRİK</span>
    <span class="logo__sub">Ankara Elektrik Servisi</span>
  </span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    color: var(--white);
    line-height: 1;
  }
  .logo--light {
    color: var(--primary-dark);
  }
  .logo__mark svg {
    width: 38px;
    height: 38px;
  }
  .logo--lg .logo__mark svg {
    width: 48px;
    height: 48px;
  }
  .logo--sm .logo__mark svg {
    width: 32px;
    height: 32px;
  }
  .logo__text {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .logo__name {
    font-weight: 900;
    font-size: 1.05rem;
    letter-spacing: 0.04em;
  }
  .logo--lg .logo__name {
    font-size: 1.35rem;
  }
  .logo__sub {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    opacity: 0.7;
  }
  .logo--sm .logo__sub {
    display: none;
  }
</style>
