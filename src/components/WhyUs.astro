---
import { whyUs } from '@data/site';
import Icon from './Icon.astro';
import SectionTitle from './SectionTitle.astro';
---

<section class="section why" id="neden-demir-elektrik" aria-labelledby="why-title">
  <div class="container">
    <SectionTitle eyebrow="Güven veren hizmet" title="Neden Demir Elektrik?" text="Küçük bir priz arızasından fabrika pano montajına kadar aynı özen ve aynı ekiple çalışıyoruz." />
    <ul class="why__grid">
      {
        whyUs.map((item, i) => (
          <li class="why__item reveal" data-delay={i % 3}>
            <span class="icon-badge"><Icon name={item.icon} /></span>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .why__grid {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 640px) {
    .why__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1024px) {
    .why__grid {
      grid-template-columns: repeat(3, 1fr);
    }
    .why__item:first-child {
      grid-column: span 1;
    }
  }
  .why__item {
    display: grid;
    gap: 0.75rem;
    padding: 1.5rem;
    border-radius: var(--radius);
    background: var(--gray-light);
    border: 1px solid transparent;
    transition: border-color var(--dur) var(--ease), background-color var(--dur) var(--ease);
  }
  .why__item:hover {
    background: var(--white);
    border-color: var(--gray-200);
  }
  .why__item p {
    color: var(--text-gray);
    font-size: var(--fs-sm);
  }
</style>
