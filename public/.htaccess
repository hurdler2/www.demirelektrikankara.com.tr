# Demir Elektrik – Apache / LiteSpeed (cPanel) yapılandırması
# Bu dosya build ile birlikte dist/ içine kopyalanır ve public_html köküne yüklenir.

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1) HTTP -> HTTPS (cPanel'de SSL aktif edildikten sonra çalışır)
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # 2) www'suz -> www (src/data/site-url.mjs içindeki adresle aynı olmalı;
  #    alan adını www'suz kullanacaksan bu bloğu ters çevir ya da sil)
  RewriteCond %{HTTP_HOST} ^demirelektrikankara\.com\.tr$ [NC]
  RewriteRule ^ https://www.demirelektrikankara.com.tr%{REQUEST_URI} [R=301,L]

  # 3) /index.html -> /   ve   /sayfa.html -> /sayfa  (tek canonical URL)
  RewriteCond %{THE_REQUEST} \s/+(.*?/)?index\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+([^\s?]+)\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L]

  # 4) Sondaki slash'i kaldır (/hizmetler/ -> /hizmetler)
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+)/$ /$1 [R=301,L]

  # 5) Uzantısız isteği ilgili .html dosyasıyla karşıla
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.*)$ $1.html [L]
</IfModule>

# 404 sayfası
ErrorDocument 404 /404.html

# Dizin listelemeyi kapat
Options -Indexes

# Doğru MIME tipleri
<IfModule mod_mime.c>
  AddType image/svg+xml .svg
  AddType image/webp .webp
  AddType image/avif .avif
  AddType font/woff2 .woff2
  AddType application/manifest+json .webmanifest
</IfModule>

# Sıkıştırma
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/xml image/svg+xml application/manifest+json
</IfModule>

# Önbellek
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/xml "access plus 1 hour"
  ExpiresByType text/xml "access plus 1 hour"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  # Hash'li Astro varlıkları değişmez
  <FilesMatch "^.*\/_astro\/.*$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  # Güvenlik başlıkları
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>
